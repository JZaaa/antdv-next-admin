{
  "name": "antdv-next-admin",
  "version": "1.0.0",
  "type": "module",
  "description": "A modern Vue 3 admin scaffold based on antdv-next",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "build:check": "vue-tsc && vite build",
    "build:demo:check": "vue-tsc && vite build --mode demo",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "check:compat": "node scripts/check-chrome100.mjs",
    "check:compat:dist": "node scripts/check-chrome100.mjs --dist dist",
    "check:ci": "npm run check:compat && npm run type-check && npm run lint && npm run test:unit:run && npm run build && npm run check:compat:dist && npm run build:demo && npm run check:compat:dist",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "lint": "oxlint src mock",
    "lint:fix": "oxlint --fix src mock",
    "format": "oxfmt --write src mock",
    "format:check": "oxfmt --check src mock"
  },
  "dependencies": {
