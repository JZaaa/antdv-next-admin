# Application Title
VITE_APP_TITLE=Antdv Next Admin

# Deployment base path, including leading and trailing slashes (e.g. /admin/).
VITE_BASE=/
# Router mode: history or hash. History requires a server-side index.html fallback.
VITE_ROUTER_HISTORY=hash
# Build precompression: false (disabled), gzip, brotli, or gzip,brotli.
# Requires server/CDN support for serving precompressed .gz/.br files.
VITE_COMPRESS=false

# Unique identifier for projects deployed on the same origin.
VITE_APP_NAMESPACE=antdv-next-admin
# Increment when cache schemas change without a package.json version bump.
# package.json version and Vite mode are also included automatically.
VITE_APP_CACHE_VERSION=1

# API Base URL
VITE_API_BASE_URL=/api
